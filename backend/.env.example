# Chat and safety checks (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
# Speech-to-text (https://console.groq.com/keys)
GROQ_API_KEY=gsk_...
# Chat model
LLM_MODEL=gpt-5.4-mini
# Speech-to-text: always the large model, it recognises Croatian much better than turbo
TRANSCRIPTION_MODEL=whisper-large-v3
# Checks questions and answers against the child-safety policy (src/safety/policy.ts)
SAFETY_MODEL=gpt-5.4-mini
# Name of the child – the AI calls her by it
CHILD_NAME=Lisa
# Firebase project of the whiteboard – only its (anonymous) users may use the API
FIREBASE_PROJECT_ID=whiteboard-32486
PORT=3200
HOST=127.0.0.1
# Extra origins allowed to call the API (comma separated)
# CORS_ORIGINS=https://example.com
