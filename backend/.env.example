GROQ_API_KEY=gsk_...
# Chat model
LLM_MODEL=openai/gpt-oss-120b
# Speech-to-text: always the large model, it recognises Croatian much better than turbo
TRANSCRIPTION_MODEL=whisper-large-v3
# Checks questions and answers against the child-safety policy (src/safety/policy.ts). Shares the free-tier
# limit of 8,000 tokens/minute with LLM_MODEL – set openai/gpt-oss-20b to give the checks their own limit.
SAFETY_MODEL=openai/gpt-oss-120b
# Name of the child – the AI calls her by it
CHILD_NAME=Lisa
# Firebase project of the whiteboard – only its (anonymous) users may use the API
FIREBASE_PROJECT_ID=whiteboard-32486
PORT=3200
HOST=127.0.0.1
# Extra origins allowed to call the API (comma separated)
# CORS_ORIGINS=https://example.com
