# Environment for the kids' chat API (Sovica).
#
# Production: /etc/kids-chat-api/kids-chat-api.env (root:root, 600), read by systemd.
# Local development: backend/.env (see backend/.env.example).
# Never commit the real file.

NODE_ENV=production
HOST=127.0.0.1
PORT=3200

# OpenAI API key for the chat and the safety checks (https://platform.openai.com/api-keys)
# - REQUIRED, fill in after setup.
OPENAI_API_KEY=
# Groq API key for speech-to-text (https://console.groq.com/keys) - REQUIRED, fill in after setup.
GROQ_API_KEY=

# Chat model
LLM_MODEL=gpt-5.4-mini
# Speech-to-text: always the large model, it recognises Croatian much better than turbo
TRANSCRIPTION_MODEL=whisper-large-v3
# Checks questions and answers against the child-safety policy
SAFETY_MODEL=gpt-5.4-mini

# Name of the child - the AI calls her by it
CHILD_NAME=Lisa

# Firebase project of the whiteboard - only its (anonymous) users may use the API
FIREBASE_PROJECT_ID=whiteboard-32486

# Extra origins allowed to call the API (comma separated). The whiteboard's
# Firebase domains and localhost:4200 are always allowed.
CORS_ORIGINS=
